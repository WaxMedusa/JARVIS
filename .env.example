# ---------------------------------------------------------------------------
# JARVIS environment. Copy to .env and fill in what you use.
# Never commit .env. All values here are optional except one LLM key.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# JARVIS_HOME=~/.jarvis
# JARVIS_NAME=JARVIS
# JARVIS_USER_NAME=Your Name
# JARVIS_ADDRESS_AS=sir
# JARVIS_TIMEZONE=Europe/Berlin
# JARVIS_LANGUAGE=English
# JARVIS_LOCALE=en-US
# JARVIS_LOG_LEVEL=info
# JARVIS_MASTER_KEY=            # optional: 64 hex chars; otherwise ~/.jarvis/master.key
# JARVIS_SHELL_ALLOWLIST=ls,pwd,cat,git status
# JARVIS_APPROVAL_MODE=balanced        # strict | balanced | autonomous
# JARVIS_ALLOW_IRREVERSIBLE=false
# JARVIS_ALLOWED_PATHS=~/Documents,~/Desktop,~/Downloads,~/JarvisVault
# JARVIS_ALLOW_PRIVATE_NETWORK=false

# --- LLM --------------------------------------------------------------------
# openai (default) | anthropic | ollama | custom | mock
JARVIS_LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# JARVIS_MODEL=gpt-4.1
# JARVIS_SMALL_MODEL=gpt-4.1-mini
# JARVIS_MAX_OUTPUT_TOKENS=4096
# JARVIS_REQUEST_TIMEOUT_MS=120000
# JARVIS_EXTRACT_FACTS=true
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# JARVIS_TEMPERATURE=0.4
# JARVIS_MAX_STEPS=12
# JARVIS_CONTEXT_WINDOW=128000
# JARVIS_EMBEDDINGS=true

# Any OpenAI-compatible endpoint works: set LLM_BASE_URL + OPENAI_API_KEY.
# Ollama: JARVIS_LLM_PROVIDER=ollama  (no key needed, http://127.0.0.1:11434/v1)

# --- Web search -------------------------------------------------------------
# Optional. Without one, a limited keyless fallback (DuckDuckGo/Wikipedia) is used.
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=https://searx.example.com

# --- Google (Calendar, Gmail, Tasks) ----------------------------------------
# Create a Desktop OAuth client and add http://127.0.0.1:53682 as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_PORT=53682
# GOOGLE_CALENDAR_ID=primary
# After setting the two values above run: jarvis auth google

# --- Canvas LMS -------------------------------------------------------------
# The desktop app stores these securely for you under School → Canvas.
# They are read from the environment by the daemon.
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# --- Other integrations -----------------------------------------------------
NOTION_API_KEY=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
LINEAR_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Generic IMAP/SMTP email
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Obsidian / notes vault (indexed automatically by the daemon)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_DAILY_FOLDER=Daily
# RSS headlines
RSS_FEEDS=https://news.ycombinator.com/rss,https://feeds.arstechnica.com/arstechnica/index

# --- Telegram (phone access) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids; send /start to the bot to learn yours.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Supabase (cloud memory backup) ----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Run docs/supabase.sql in the Supabase SQL editor first.
# JARVIS_SUPABASE_AUTOSYNC=false

# --- HTTP daemon ------------------------------------------------------------
JARVIS_SERVER_HOST=127.0.0.1
JARVIS_SERVER_PORT=8765
# Required if you bind a non-loopback host.
JARVIS_API_TOKEN=

# --- Proactive behaviour ----------------------------------------------------
JARVIS_PROACTIVE=true
JARVIS_NOTIFY_CHANNELS=console
# JARVIS_MORNING_BRIEF=07:30
# JARVIS_EVENING_REVIEW=21:30
# JARVIS_WEBHOOK_URL=

# --- Voice ------------------------------------------------------------------
# Used by CLI recording/playback and by the companion's dictation / voice notes.
JARVIS_VOICE=false
# STT_MODEL=whisper-1
# STT_LANGUAGE=
# TTS_MODEL=tts-1
# TTS_VOICE=onyx
# JARVIS_MAX_AUDIO_MB=25
# JARVIS_AUDIO_NOTE_SUMMARY=true

# --- Offline demo -----------------------------------------------------------
# JARVIS_LLM_PROVIDER=mock
# JARVIS_MOCK_SCRIPT=[{"toolCalls":[{"id":"c1","name":"remember","arguments":"{\"content\":\"Demo memory\"}"}]},{"text":"Done."}]
