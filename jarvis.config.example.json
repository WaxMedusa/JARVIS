{
  "assistant": {
    "name": "JARVIS",
    "userName": "Your Name",
    "persona": "You are JARVIS, a brilliant, discreet personal chief-of-staff. You are calm, precise, lightly witty, and unfailingly competent. You anticipate needs instead of waiting to be told. You never pad answers with filler.",
    "timezone": "Europe/Berlin",
    "language": "English",
    "addressUserAs": "sir",
    "verbosity": "concise"
  },
  "llm": {
    "provider": "openai",
    "model": "gpt-4.1",
    "smallModel": "gpt-4.1-mini",
    "embeddingModel": "text-embedding-3-small",
    "temperature": 0.4,
    "maxOutputTokens": 4096,
    "contextWindow": 128000,
    "maxSteps": 12,
    "embeddings": true
  },
  "memory": {
    "recallLimit": 10,
    "extractFacts": true,
    "consolidateEveryTurns": 6,
    "autoIndexVault": true
  },
  "security": {
    "approvalMode": "balanced",
    "allowIrreversible": false,
    "allowedPaths": ["~/Documents", "~/Desktop", "~/Downloads", "~/JarvisVault"],
    "shellAllowlist": ["ls", "pwd", "cat", "head", "tail", "grep", "rg", "find", "df", "uptime", "git status", "git log", "git diff"],
    "allowPrivateNetwork": false
  },
  "proactive": {
    "enabled": true,
    "channels": ["console"],
    "morningBrief": "07:30",
    "eveningReview": "21:30",
    "weeklyReviewCron": "0 18 * * 0",
    "quietHours": { "start": "22:30", "end": "07:00" },
    "jobs": [
      {
        "name": "inbox_triage",
        "cron": "0 9 * * 1-5",
        "prompt": "Check my unread email from the last 24 hours. Summarise anything that needs a reply, with sender and action. Keep it under 120 words.",
        "channel": "console",
        "enabled": false
      }
    ]
  },
  "integrations": {
    "obsidian": {
      "vaultPath": "~/JarvisVault",
      "dailyNoteFolder": "Daily"
    },
    "rss": {
      "feeds": ["https://news.ycombinator.com/rss"]
    },
    "mcp": {
      "servers": [
        {
          "name": "filesystem",
          "enabled": false,
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/you/Notes"],
          "risk": "read"
        }
      ]
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "logging": {
    "level": "info",
    "file": true
  }
}
