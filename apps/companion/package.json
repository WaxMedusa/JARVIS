{
  "name": "jarvis-companion",
  "version": "3.0.1",
  "private": true,
  "description": "JARVIS — a self-contained desktop AI chief-of-staff for macOS",
  "author": "WaxMedusa",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "assets": "node scripts/generate-assets.mjs",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "test": "node --test test/*.test.js",
    "pack": "npm run prepare:backend && electron-builder --dir",
    "dist:mac": "npm run prepare:backend && electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.waxmedusa.jarvis.companion",
    "productName": "JARVIS",
    "copyright": "Copyright © 2026 WaxMedusa",
    "asar": true,
    "files": [
      "src/**/*",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extraResources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "JARVIS-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": false,
        "LSMinimumSystemVersion": "11.0",
        "NSHighResolutionCapable": true,
        "NSMicrophoneUsageDescription": "JARVIS uses the microphone only when you dictate a message or record a voice note."
      }
    },
    "dmg": {
      "title": "JARVIS ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
